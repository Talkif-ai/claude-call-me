{
  "v": 1,
  "redacted": "[redacted]",
  "algorithm": [
    "own forms := the agent credential string, and for each 32-byte private key of this agent: base64url without padding, base64 with padding, base64 without padding, lowercase hex, uppercase hex. Forms shorter than 16 characters are ignored.",
    "scrub(text, own) := first every occurrence of every own form replaced by redacted (longest form first); then every pattern applied in order, each to the output of the previous one, replacing every match (global) by its replace text; ci = case-insensitive.",
    "containsOwn(text, own) := any of those forms occurs in text. A runner result that containsOwn before scrubbing is withheld, not sent."
  ],
  "patterns": [
    {
      "id": "private-key-block",
      "pattern": "-----BEGIN [A-Z0-9 ]*KEY-----[\\s\\S]*?(-----END [A-Z0-9 ]*KEY-----|$)",
      "replace": "[redacted]"
    },
    {
      "id": "url-userinfo",
      "pattern": "\\b([A-Za-z][A-Za-z0-9+.-]*://)[^\\s/@:]+:[^\\s/@]+@",
      "replace": "$1[redacted]@"
    },
    {
      "id": "openai-anthropic",
      "pattern": "\\bsk-(ant-)?[A-Za-z0-9_-]{16,}",
      "replace": "[redacted]"
    },
    {
      "id": "stripe",
      "pattern": "\\b(sk|rk|pk)_(live|test)_[A-Za-z0-9]{10,}",
      "replace": "[redacted]"
    },
    {
      "id": "stripe-webhook",
      "pattern": "\\bwhsec_[A-Za-z0-9]{20,}",
      "replace": "[redacted]"
    },
    {
      "id": "github",
      "pattern": "\\bgh[pousr]_[A-Za-z0-9]{20,}",
      "replace": "[redacted]"
    },
    {
      "id": "github-pat",
      "pattern": "\\bgithub_pat_[A-Za-z0-9_]{20,}",
      "replace": "[redacted]"
    },
    {
      "id": "slack",
      "pattern": "\\bxox[abposr]-[A-Za-z0-9-]{10,}",
      "replace": "[redacted]"
    },
    {
      "id": "aws-key-id",
      "pattern": "\\b(AKIA|ASIA)[A-Z0-9]{16}\\b",
      "replace": "[redacted]"
    },
    {
      "id": "jwt",
      "pattern": "\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}",
      "replace": "[redacted]"
    },
    {
      "id": "google-api-key",
      "pattern": "\\bAIza[0-9A-Za-z_-]{35}",
      "replace": "[redacted]"
    },
    {
      "id": "npm-token",
      "pattern": "\\bnpm_[A-Za-z0-9]{36}",
      "replace": "[redacted]"
    },
    {
      "id": "talkif",
      "pattern": "\\btif_(live|test|agent)_[A-Za-z0-9]{8,}",
      "replace": "[redacted]"
    },
    {
      "id": "json-field",
      "ci": true,
      "pattern": "(\"[^\"\\n]*(key|token|secret|password|passwd|private|credential)[^\"\\n]*\"\\s*:\\s*)\"[^\"\\n]*\"",
      "replace": "$1\"[redacted]\""
    },
    {
      "id": "yaml-field",
      "ci": true,
      "pattern": "(^|\\s)([A-Za-z0-9_.-]*(key|token|secret|password|passwd|credential)[A-Za-z0-9_.-]*:[ \\t]+)([^\\s\"'\\[{][^\\s]*)",
      "replace": "$1$2[redacted]"
    },
    {
      "id": "assignment",
      "ci": true,
      "pattern": "\\b([A-Za-z0-9_]*(KEY|TOKEN|SECRET|PASSWORD|PASSWD))\\s*=\\s*(\"[^\"]*\"|'[^']*'|\\S+)",
      "replace": "$1=[redacted]"
    }
  ],
  "cases": [
    {
      "text": "key tif_agent_abcdefghijklmnop1234 end",
      "out": "key [redacted] end"
    },
    {
      "text": "tif_live_abcdefgh12345678",
      "out": "[redacted]"
    },
    {
      "text": "OPENAI_API_KEY=sk-abcdefghijklmnopqrstuv",
      "out": "OPENAI_API_KEY=[redacted]"
    },
    {
      "text": "{\"password\": \"hunter2hunter2\"}",
      "out": "{\"password\": \"[redacted]\"}"
    },
    {
      "text": "{\"apiKey\":\"abc\",\"name\":\"x\"}",
      "out": "{\"apiKey\":\"[redacted]\",\"name\":\"x\"}"
    },
    {
      "text": "{\"v\":1,\"boxPrivate\":\"q83vEjRWeJA\",\"signPrivate\":\"AAECAwQFBgc\"}",
      "out": "{\"v\":1,\"boxPrivate\":\"[redacted]\",\"signPrivate\":\"[redacted]\"}"
    },
    {
      "text": "DATABASE_URL is postgres://user:supersecret@db.example.com/app",
      "out": "DATABASE_URL is postgres://[redacted]@db.example.com/app"
    },
    {
      "text": "git clone https://bob:tok123@example.com/o/r.git",
      "out": "git clone https://[redacted]@example.com/o/r.git"
    },
    {
      "text": "sk_live_abcdefghij1234 and rk_test_ABCDEFGHIJ99",
      "out": "[redacted] and [redacted]"
    },
    {
      "text": "key AIzaSyA1234567890abcdefghijklmnopqrstuv end",
      "out": "key [redacted] end"
    },
    {
      "text": "//registry.npmjs.org/:_authToken=npm_abcdefghijklmnopqrstuvwxyz0123456789",
      "out": "//registry.npmjs.org/:_authToken=[redacted]"
    },
    {
      "text": "password: hunter2\nuser: bob",
      "out": "password: [redacted]\nuser: bob"
    },
    {
      "text": "-----BEGIN OPENSSH PRIVATE KEY-----\nabc\n-----END OPENSSH PRIVATE KEY-----\nafter",
      "out": "[redacted]\nafter"
    },
    {
      "text": "-----BEGIN PRIVATE KEY-----\ncut off",
      "out": "[redacted]"
    },
    {
      "text": "AKIAABCDEFGHIJKLMNOP",
      "out": "[redacted]"
    },
    {
      "text": "token ghp_abcdefghijklmnopqrstuvwxyz",
      "out": "token [redacted]"
    },
    {
      "text": "https://example.com/docs and plain text",
      "out": "https://example.com/docs and plain text"
    },
    {
      "text": "{\"taskId\":\"t-1\",\"state\":\"completed\"}",
      "out": "{\"taskId\":\"t-1\",\"state\":\"completed\"}"
    }
  ],
  "own": {
    "credential": "tif_agent_ownvaluetestabcdefghij0123",
    "keyHex": "77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a",
    "cases": [
      {
        "text": "box 77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a end",
        "out": "box [redacted] end",
        "contains": true
      },
      {
        "text": "B64 dwdtCnMYpX08FsFyUbJmRd9ML4frwJkqsXf7pR25LCo= end",
        "out": "B64 [redacted] end",
        "contains": true
      },
      {
        "text": "b64u dwdtCnMYpX08FsFyUbJmRd9ML4frwJkqsXf7pR25LCo end",
        "out": "b64u [redacted] end",
        "contains": true
      },
      {
        "text": "HEX 77076D0A7318A57D3C16C17251B26645DF4C2F87EBC0992AB177FBA51DB92C2A",
        "out": "HEX [redacted]",
        "contains": true
      },
      {
        "text": "nothing here",
        "out": "nothing here",
        "contains": false
      }
    ]
  }
}
